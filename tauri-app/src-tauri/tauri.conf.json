{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mhyscan",
  "version": "0.4.2",
  "identifier": "com.polaristime.mhyscan",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mhyscan",
        "width": 1200,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "米哈游直播流抢码工具",
    "longDescription": "识别 B站 / 抖音直播流中的米哈游登录二维码，并使用已登录账号自动抢码。",
    "category": "Utility",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "B3B0D9D4-2C6A-5B4F-9E22-8A7C1D6F4E31"
      }
    }
  }
}
